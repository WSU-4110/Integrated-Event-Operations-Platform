# Copy to .env and fill in. Never commit .env.
# Nothing loads this file automatically yet: export these in your shell
# (or run with `node --env-file=.env`) before starting a package.

# --- Required by both servers ---
# Each package reads its own PORT. Defaults used on Replit: API 8080, web 19235.
PORT=8080
# Web app only: the path the site is served from.
BASE_PATH=/

# --- Database (lib/db) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# --- Admin access (artifacts/api-server/src/routes/admin.ts) ---
# Only the signed-in user whose email matches this can use /api/admin/*.
ADMIN_EMAIL=

# --- Email (artifacts/api-server/src/lib/waitlistConfirmationEmail.ts) ---
RESEND_FROM_EMAIL="BuilderWars <hello@builderwars.dev>"

# --- Production hosting (artifacts/api-server/src/app.ts, docs/deployment.md) ---
# Redirect every other hostname here. Leave unset locally and until DNS is live.
CANONICAL_HOST=
# Where the built web app is. Defaults to artifacts/hackathon/dist/public.
WEB_DIST_DIR=

# --- Replit-only, to be replaced (see docs/development.md, "Still tied to Replit") ---
# OIDC client id for Replit Auth. Has no value outside Replit.
REPL_ID=
# Defaults to https://replit.com/oidc when unset.
ISSUER_URL=

# --- Optional ---
LOG_LEVEL=info
NODE_ENV=development
