# Copy to .env and fill in. Never commit .env.
# Nothing loads this file automatically yet: export these in your shell
# (or run with `node --env-file=.env`) before starting a package.

# --- Required by both servers ---
# Each package reads its own PORT. Defaults used on Replit: API 8080, web 19235.
PORT=8080
# Web app only: the path the site is served from.
BASE_PATH=/

# --- Database (lib/db) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
# Production only (set in the Docker image): verify the database's SSL
# certificate against this CA bundle, and apply migrations on start.
DATABASE_SSL_CA=
RUN_MIGRATIONS=

# --- Sign-in and admin access (docs/google-sign-in.md) ---
# Google OAuth client for organizer sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed to use /api/admin/*.
ADMIN_EMAILS=
# Optional. Defaults to https://accounts.google.com.
ISSUER_URL=

# --- Email (artifacts/api-server/src/lib/registrationConfirmationEmail.ts) ---
# Without RESEND_API_KEY, registrations still save but no email is sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL="BuilderWars <hello@builderwars.dev>"

# --- Production hosting (artifacts/api-server/src/app.ts, docs/deployment.md) ---
# Redirect every other hostname here. Leave unset locally and until DNS is live.
CANONICAL_HOST=
# Where the built web app is. Defaults to artifacts/hackathon/dist/public.
WEB_DIST_DIR=

# --- Optional ---
LOG_LEVEL=info
NODE_ENV=development
