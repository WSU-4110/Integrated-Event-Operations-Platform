# Copy to .env and fill in. Never commit .env.

# Runtime
NODE_ENV=development            # development | production | test
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# Discord (Developer Portal -> your application)
DISCORD_TOKEN=                  # Bot tab -> Reset Token. Secret!
DISCORD_CLIENT_ID=              # General Information -> Application ID
DISCORD_GUILD_ID=               # Right-click the server -> Copy Server ID

# Roles and channels (Developer Mode on; right-click -> Copy ID)
ORGANIZER_ROLE_IDS=             # comma-separated
PARTICIPANT_ROLE_ID=
VERIFICATION_LOG_CHANNEL_ID=    # organizer-only channel
ANNOUNCEMENT_CHANNEL_ID=        # where /announce posts (/announce is off until this is set)

# Database: builderwars-db as the discord_bot_app role (never the master user).
# Don't put sslmode or other SSL parameters in the URL; use the DB_SSL_* settings.
DATABASE_URL=postgres://discord_bot_app:<password>@<lightsail-endpoint>:5432/postgres
DB_SSL_MODE=verify-full         # verify-full (production) | disable (local docker only)
DB_SSL_CA_PATH=./certs/global-bundle.pem  # https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

# Event
EVENT_ID=builderwars-2026       # registrations.event_id to verify against
EVENT_TIMEZONE=America/Detroit  # times typed in organizer commands (/admin, /announce) use this zone
REGISTRATION_URL=https://builderwars.dev/#register
SYNC_INTERVAL_MINUTES=15        # how often roles are re-synced with the website (1-59)
